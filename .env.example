# ============================================================
# 环境变量模板 —— 可安全提交到版本库
# Environment variable template — safe to commit.
# 使用方式：复制为 .env 并填入真实值
#   cp .env.example .env
# Spring Boot 通过 application.yml 中的
#   spring.config.import=optional:file:.env[.properties]
# 自动加载本文件中的变量（.env 已被 .gitignore 忽略，不会入库）。
# ============================================================

# 数据库账号密码（必填）
DB_USERNAME=root
DB_PASSWORD=your_strong_db_password

# JWT 签名密钥（必填，Base64 编码的随机密钥，至少 256-bit / 32 字节）
# 生成示例:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_base64_encoded_secret
